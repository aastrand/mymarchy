#!/usr/bin/env bash
# capture — copy live system state INTO this repo.
#
# Run this after changing any tracked config, so the repo reflects reality.
# Safe to run any time; it only writes inside the repo.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

manifest_lines() { grep -vE '^\s*(#|$)' "$1" 2>/dev/null || true; }

echo "==> $HOME files"
while IFS= read -r rel; do
  src="$HOME/$rel"
  dst="$REPO/home/$rel"
  if [[ -e "$src" ]]; then
    mkdir -p "$(dirname "$dst")"
    cp -a "$src" "$dst"
    echo "    $rel"
  else
    echo "    MISSING: $rel" >&2
  fi
done < <(manifest_lines manifest/home.txt)

echo "==> root-owned files"
while IFS= read -r abs; do
  dst="$REPO/system${abs}"
  if [[ -r "$abs" ]]; then
    mkdir -p "$(dirname "$dst")"
    cp "$abs" "$dst"
    echo "    $abs"
  else
    echo "    UNREADABLE (needs root?): $abs" >&2
  fi
done < <(manifest_lines manifest/system.txt)

echo "==> package manifests"
pacman -Qqen > system/packages/pacman-explicit.txt   # official repos, explicitly installed
pacman -Qqem > system/packages/aur-explicit.txt      # foreign/AUR, explicitly installed
echo "    $(wc -l < system/packages/pacman-explicit.txt) official, $(wc -l < system/packages/aur-explicit.txt) AUR"

echo "==> omarchy shell plugins"
# Plugins are git clones managed by `omarchy plugin add/update/remove`, so the
# source is deliberately NOT vendored here -- copying it in would fight
# `omarchy plugin update` and drag a multi-megabyte preview image into the repo
# for no benefit. Record what to reinstall instead, the way packages are handled.
# Which plugins are *enabled*, and their per-plugin settings, already ride along
# in home/.config/omarchy/shell.json.
: > system/packages/omarchy-plugins.txt
if [[ -d "$HOME/.config/omarchy/plugins" ]]; then
  for plugin in "$HOME/.config/omarchy/plugins"/*/; do
    [[ -d $plugin ]] || continue
    printf '%s\t%s\n' "$(basename "$plugin")" \
      "$(git -C "$plugin" remote get-url origin 2>/dev/null || echo 'NOT-GIT-MANAGED')"
  done | sort > system/packages/omarchy-plugins.txt
fi
echo "    $(wc -l < system/packages/omarchy-plugins.txt) plugin(s)"

echo "==> enabled systemd units"
systemctl list-unit-files --state=enabled --no-pager --no-legend \
  | awk '{print $1}' | sort > system/systemd/enabled-units.txt
systemctl --user list-unit-files --state=enabled --no-pager --no-legend 2>/dev/null \
  | awk '{print $1}' | sort > system/systemd/enabled-units-user.txt
echo "    $(wc -l < system/systemd/enabled-units.txt) system, $(wc -l < system/systemd/enabled-units-user.txt) user"

echo "==> fstab (reference only — never restored automatically)"
cp /etc/fstab system/etc/fstab.reference

echo
echo "Done. Review with: git -C '$REPO' diff"
