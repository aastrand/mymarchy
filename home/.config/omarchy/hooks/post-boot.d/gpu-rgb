#!/bin/bash
# Set the graphics card's RGB to the warm gold used across this machine.
#
# OpenRGB is the only thing that can reach the GPU: its lighting lives on the
# card's own ENE SMBus controller, which liquidctl and CoolerControl cannot
# touch. Every other device here -- Kraken ring/logo, the NZXT RGB & Fan
# Controller, the motherboard Aura -- is owned by coolercontrold, which applies
# its own settings on boot and after resume, so they need nothing here.
#
# Matched by name rather than by index: OpenRGB numbers devices in detection
# order, so `--device 0` shifts whenever a USB RGB device (keyboard, etc.) is
# plugged in or removed.
#
# This runs about two seconds into the Hyprland session, which may be before
# i2c-dev is loaded and udev has applied ACLs to /dev/i2c-*. OpenRGB exits 255
# with `Cannot find device` when that happens, so retry on a non-zero exit.
# Each attempt costs a full ~7s detection sweep, hence the modest retry count.
#
# The outcome is logged, because this hook must never fail the boot chain and
# a silent failure would show up only as a rainbow GPU with no explanation:
#
#   journalctl -t gpu-rgb -b

DEVICE="ASUS ROG STRIX GeForce RTX 5070 Ti Gaming OC"
COLOR="AA8528"
ATTEMPTS=5
DELAY=3

for i in $(seq 1 "$ATTEMPTS"); do
  if openrgb --device "$DEVICE" --mode Static --color "$COLOR" >/dev/null 2>&1; then
    logger -t gpu-rgb "set to #$COLOR on attempt $i"
    exit 0
  fi
  logger -t gpu-rgb "attempt $i/$ATTEMPTS failed (device not ready?)"
  sleep "$DELAY"
done

logger -t gpu-rgb "FAILED: could not set $DEVICE after $ATTEMPTS attempts"
exit 0   # never fail the boot hook chain
