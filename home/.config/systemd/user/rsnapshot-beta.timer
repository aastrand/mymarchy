[Unit]
Description=rsnapshot beta (daily, wall-clock)

[Timer]
# Wall-clock rather than uptime -- see rsnapshot-alpha.timer for why the
# OnUnitActiveSec/OnBootSec pair silently skipped runs across suspend.
OnCalendar=*-*-* 03:20:00
Persistent=true
RandomizedDelaySec=5m

Unit=rsnapshot@beta.service

[Install]
WantedBy=timers.target
