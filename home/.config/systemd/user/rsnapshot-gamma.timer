[Unit]
Description=rsnapshot gamma (weekly, wall-clock)

[Timer]
# Wall-clock rather than uptime -- see rsnapshot-alpha.timer for why the
# OnUnitActiveSec/OnBootSec pair silently skipped runs across suspend.
OnCalendar=Mon *-*-* 03:40:00
Persistent=true
RandomizedDelaySec=5m

Unit=rsnapshot@gamma.service

[Install]
WantedBy=timers.target
