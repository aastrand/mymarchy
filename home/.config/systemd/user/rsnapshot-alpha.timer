[Unit]
Description=rsnapshot alpha (every 2h, wall-clock)

[Timer]
# Wall-clock, not uptime. OnUnitActiveSec counts on the monotonic clock, which
# stops while the machine is suspended, and OnBootSec only fires after a real
# boot -- a resume is neither. This desktop sleeps overnight rather than
# shutting down, so the old uptime-relative pair could leave a 20h suspend
# looking like no time had passed at all, and no backup ran for a whole day.
#
# Persistent=true needs OnCalendar to do anything; it was previously set
# alongside OnUnitActiveSec, where it was silently inert. With OnCalendar it
# records the last run on disk and fires a missed one shortly after resume.
OnCalendar=*-*-* 00/2:00:00
Persistent=true

# Catch-up runs for several intervals can come due at the same resume. That is
# harmless -- rsnapshot-interval holds an flock so they queue instead of
# colliding on rsnapshot's single pidfile -- but the jitter keeps them from
# all waking the NAS in the same second.
RandomizedDelaySec=5m

Unit=rsnapshot@alpha.service

[Install]
WantedBy=timers.target
