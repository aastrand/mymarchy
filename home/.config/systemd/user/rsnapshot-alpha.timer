[Unit]
Description=rsnapshot alpha (every 6h of uptime)

[Timer]
# Measured from the last run rather than the wall clock, so a machine that is
# switched off still gets its rotations -- paced by uptime instead of by luck.
OnUnitActiveSec=6h
# Catch up after boot, staggered per interval so overdue timers do not all
# stampede at once the way they did under OnCalendar.
OnBootSec=10min
Persistent=true
RandomizedDelaySec=5m
Unit=rsnapshot@alpha.service

[Install]
WantedBy=timers.target
