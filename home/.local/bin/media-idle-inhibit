#!/usr/bin/env bash
set -uo pipefail

# Keep Omarchy awake for intentional video playback:
#   - Firefox media from explicitly allowed streaming sites
#   - mpv, the system's default local video player
# Raw PipeWire activity is deliberately ignored: VMware and krengine keep
# streams open while idle, and Spotify is intentionally excluded.

readonly OMARCHY_STATE="$HOME/.local/state/omarchy/indicators/stay-awake"
readonly STATE_DIR="$HOME/.local/state/media-idle-inhibit"
readonly OWNED_STATE="$STATE_DIR/owns-stay-awake"
readonly FIREFOX_URL_RE='^https?://([^/]+\.)?(youtube\.com|youtu\.be|twitch\.tv|netflix\.com)(/|$)'

mkdir -p "$STATE_DIR"

playback_status() {
  busctl --user get-property \
    "$1" \
    /org/mpris/MediaPlayer2 \
    org.mpris.MediaPlayer2.Player \
    PlaybackStatus 2>/dev/null || true
}

firefox_url() {
  busctl --user get-property \
    "$1" \
    /org/mpris/MediaPlayer2 \
    org.mpris.MediaPlayer2.Player \
    Metadata 2>/dev/null \
    | sed -n 's/.*"xesam:url" s "\([^"]*\)".*/\1/p'
}

media_is_playing() {
  local player url

  while read -r player; do
    [[ -n "$player" ]] || continue
    [[ $(playback_status "$player") == 's "Playing"' ]] || continue

    case "$player" in
      org.mpris.MediaPlayer2.mpv|org.mpris.MediaPlayer2.mpv.*)
        return 0
        ;;
      org.mpris.MediaPlayer2.firefox.*)
        url=$(firefox_url "$player")
        [[ "$url" =~ $FIREFOX_URL_RE ]] && return 0
        ;;
    esac
  done < <(
    busctl --user list --no-legend 2>/dev/null \
      | awk '$1 ~ /^org\.mpris\.MediaPlayer2\.(firefox\.|mpv(\.|$))/ { print $1 }'
  )

  return 1
}

release_owned_inhibit() {
  if [[ -e "$OWNED_STATE" ]]; then
    omarchy toggle idle allow-idle >/dev/null
    rm -f "$OWNED_STATE"
  fi
}

trap release_owned_inhibit EXIT
trap 'exit 0' INT TERM

while true; do
  if media_is_playing; then
    if [[ ! -e "$OMARCHY_STATE" ]]; then
      omarchy toggle idle stay-awake >/dev/null
      touch "$OWNED_STATE"
    fi
  else
    release_owned_inhibit
  fi

  sleep 2
 done
