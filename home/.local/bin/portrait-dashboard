#!/bin/bash
# Restore the desktop: a terminal and Firefox side by side on the ultrawide
# (ws1 / DP-1), and btop / Firefox / Spotify stacked on the portrait screen
# (ws2 / DP-2). Tiled throughout, not floating.
#
# Replaces the Ubuntu-era restore_desktop.sh, which placed windows at absolute
# pixel coordinates via wmctrl and the GNOME Window Calls extension -- GNOME is
# a floating WM, so that was the only option there. Here the windows stay
# genuinely tiled: a fourth window still tiles, closing one reflows the rest,
# and focus/swap bindings keep working.
#
# Portrait stack, rebuilt from scratch each run because dwindle's layout is
# decided entirely by insertion order. Windows are parked on a special
# workspace, then reinserted one at a time with focus set so each split lands
# where it should:
#
#     root
#     |-- btop     19.5%
#     `-- node
#         |-- firefox  55.2%
#         `-- spotify  24.2%
#
# NOTE ON SYNTAX: Omarchy configures Hyprland in Lua, which replaces the legacy
# `hyprctl dispatch <name> <args>` form. Legacy calls fail with "')' expected
# near ..." and exit 7. Dispatchers must be written as Lua, e.g.
#   hyprctl dispatch 'hl.dsp.window.move({ window = "address:0x1", workspace = "2" })'
# hyprctl eval cannot return values, so introspect the API by writing a file:
#   hyprctl eval "local f=io.open('/tmp/o','w')
#                 for k,v in pairs(hl.dsp.window) do f:write(k..'\n') end f:close()"

set -uo pipefail

# Only one run at a time. Two overlapping runs both see "no Firefox windows
# yet" during a cold start and both launch it, and a second invocation against
# a running Firefox opens an empty window rather than doing nothing.
#
# The lock lives on fd 9, and a flock is held until every copy of that file
# descriptor is closed -- including the copies children inherit across exec.
# The apps launched below outlive this script by design, so without an explicit
# close they keep the lock forever and every later run bails out with "another
# run is in progress". Each launch site therefore adds `9>&-`; see them below.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/portrait-dashboard.lock"
if ! flock -n 9; then
  echo "  another run is in progress" >&2
  exit 0
fi

MAIN_WS=1
MAIN_MONITOR=DP-1
WS=2
MONITOR=DP-2
PARK="special:dashboard-build"

# Fractions of usable height on the portrait screen, top to bottom. Spotify
# takes the remainder. Measured from the layout after adjusting the splits by
# hand rather than guessed: 489 / 1385 / 608 px of 2510px usable.
F_BTOP=0.195
F_FIREFOX=0.552

# btop runs in a plain terminal under its own class rather than through
# omarchy-launch-or-focus-tui. That helper uses the app-id org.omarchy.btop,
# which Omarchy tags "+floating-window" (float, centred, 875x600) for the
# transient SUPER+CTRL+T overlay, and a floating window cannot join a tiled
# stack. Padding is also zeroed and the font shrunk: kitty's usual 14px padding
# costs 28px vertically -- about one text row -- which is enough to put btop
# under its 24-row minimum in a pane this short.
BTOP_MATCH='^dashboard-btop$'
BTOP_LAUNCH='uwsm app -- kitty --class dashboard-btop -o window_padding_width=0 -o font_size=10 -e btop'
FIREFOX_MATCH='^firefox$'
# Cold start: plain `firefox`, so session restore reopens the previous windows.
# Adding --new-window to a cold start produces a blank window on top of the
# restored ones. --new-window is only right when Firefox is already running and
# a second window is genuinely needed.
FIREFOX_LAUNCH='uwsm app -- firefox'
FIREFOX_LAUNCH_EXTRA='uwsm app -- firefox --new-window'
SPOTIFY_MATCH='^Spotify$'
SPOTIFY_LAUNCH='uwsm app -- spotify'
TERM_MATCH='^kitty$'
TERM_LAUNCH='uwsm app -- kitty'

# On a cold start Firefox restores several windows from its sessionstore, in a
# stable order. These pick which restored window goes to which screen (1-based).
# Titles cannot be used instead -- a Firefox window is titled after its active
# tab, so it changes as soon as you switch tabs.
# If the two screens come up swapped, flip these.
FF_MAIN_INDEX=2        # -> ultrawide (ws1)
FF_PORTRAIT_INDEX=1    # -> portrait  (ws2)

log() { printf '  %s\n' "$*" >&2; }

# Animations make every move play a transition, which is both the visible churn
# during a rebuild and a real part of the wall-clock cost. Suppress them for the
# duration and restore on any exit, including failure.
anim() { hyprctl keyword animations:enabled "$1" >/dev/null 2>&1 ||
         hyprctl eval "hl.config({ animations = { enabled = $2 } })" >/dev/null 2>&1; }
restore_anim() { anim 1 true; }
trap restore_anim EXIT INT TERM

dispatch() {
  local lua=$1 out
  out=$(hyprctl dispatch "$lua" 2>&1)
  if [[ $out != "ok" ]]; then
    log "DISPATCH FAILED: $lua"
    log "  -> $out"
    return 1
  fi
}

addr_on_ws() {
  hyprctl clients -j | jq -r --arg re "$1" --argjson ws "$2" \
    'map(select((.class | test($re)) and .workspace.id == $ws))
     | if length > 0 then .[0].address else "" end'
}

addrs_matching() {
  hyprctl clients -j | jq -r --arg re "$1" '.[] | select(.class | test($re)) | .address'
}

ws_of() {
  hyprctl clients -j | jq -r --arg a "$1" '.[] | select(.address == $a) | .workspace.id'
}

# Poll until window $1 is on workspace $2. Waiting for the state actually
# wanted beats sleeping a fixed guess: it returns the moment it is true, and
# waits longer when the machine is busy instead of racing.
wait_ws() {
  local a=$1 want=$2
  for _ in $(seq 1 40); do
    [[ $(ws_of "$a") == "$want" ]] && return 0
    sleep 0.05
  done
  return 1
}

# Same, but by workspace *name*. Special workspaces are allocated an
# unpredictable negative id, so parking has to be waited on by name.
wait_ws_name() {
  local a=$1 want=$2 cur
  for _ in $(seq 1 40); do
    cur=$(hyprctl clients -j | jq -r --arg a "$a" '.[] | select(.address==$a) | .workspace.name')
    [[ $cur == "$want" ]] && return 0
    sleep 0.05
  done
  return 1
}

# Poll until window $1's height stops changing, so a resize has settled.
wait_settled() {
  local a=$1 last="" cur
  for _ in $(seq 1 40); do
    cur=$(hyprctl clients -j | jq -r --arg a "$a" '.[] | select(.address==$a) | .size[1]')
    [[ -n $cur && $cur == "$last" ]] && return 0
    last=$cur
    sleep 0.05
  done
}

# Ensure workspace $3 has a window matching $1, launching $2 if not.
#
# $4 decides what to do when the app is running but its window is elsewhere:
#
#   move  - claim that window (single-window apps: Spotify, btop). This is what
#           restore_desktop.sh did throughout -- launch() only ran a process
#           when pgrep found nothing, and move() did the rest.
#   new   - leave it alone and open another window (Firefox, terminals). These
#           legitimately have one window per screen, and claiming an existing
#           one would drag the ultrawide's browser onto the portrait monitor.
#
# When launching, waits for an address that did not exist beforehand, so
# another window of the same app is never mistaken for the new one.
ensure() {
  local re=$1 cmd=$2 ws=$3 policy=$4 a before after
  a=$(addr_on_ws "$re" "$ws")
  if [[ -n $a ]]; then
    log "ws$ws: reusing $re"
    echo "$a"; return 0
  fi

  if [[ $policy == move ]]; then
    a=$(addrs_matching "$re" | head -1)
    if [[ -n $a ]]; then
      log "ws$ws: claiming existing $re"
      echo "$a"; return 0
    fi
  fi

  before=$(addrs_matching "$re" | sort)
  log "ws$ws: launching $cmd"
  setsid $cmd >/dev/null 2>&1 9>&- &

  for _ in $(seq 1 100); do
    sleep 0.1
    after=$(addrs_matching "$re" | sort)
    a=$(comm -13 <(echo "$before") <(echo "$after") | head -1)
    [[ -n $a ]] && { echo "$a"; return 0; }
  done
  log "TIMED OUT waiting for a new $re window"
  return 1
}

geom() {
  hyprctl clients -j | jq -r --arg a "$1" \
    '.[] | select(.address == $a) | "\(.at[0]) \(.at[1]) \(.size[0]) \(.size[1])"'
}

# Produce exactly two Firefox windows, one per screen, and echo their addresses.
#
# Firefox needs handling of its own because it restores a session. Starting it
# cold reopens however many windows were last open, so the count cannot be
# predicted -- and asking for --new-window on a cold start yields a blank window
# on top of the restored ones, which is the "extra empty Firefox" this used to
# produce. So: start it plain, let the session settle, then top up only if the
# restore gave fewer than two.
ensure_two_firefox() {
  local n before cold=0

  # Order in which restored windows appeared, oldest first. Firefox restores
  # from its sessionstore in a stable order, so this is reproducible across
  # reboots -- unlike window titles, which change with the active tab and so
  # cannot be matched on.
  FF_ORDER=()

  n=$(addrs_matching "$FIREFOX_MATCH" | wc -l)
  # Check the process, not just mapped windows: during startup Firefox is
  # running with nothing mapped yet, and launching it again in that gap adds
  # an empty window instead of being a no-op.
  if (( n == 0 )) && pgrep -x firefox >/dev/null 2>&1; then
    log "firefox is starting up -- waiting for its windows rather than launching again"
    for _ in $(seq 1 120); do
      sleep 0.25
      (( $(addrs_matching "$FIREFOX_MATCH" | wc -l) > 0 )) && break
    done
    n=$(addrs_matching "$FIREFOX_MATCH" | wc -l)
  fi
  if (( n == 0 )); then
    cold=1
    log "firefox not running -- starting it and letting session restore settle"
    setsid $FIREFOX_LAUNCH >/dev/null 2>&1 9>&- &
    # Wait for the first window...
    for _ in $(seq 1 120); do
      sleep 0.25
      (( $(addrs_matching "$FIREFOX_MATCH" | wc -l) > 0 )) && break
    done
    # ...then until the count has held steady for a good while.
    #
    # Restoring a session is slow and lumpy -- a multi-megabyte sessionstore can
    # leave seconds between one window appearing and the next. Breaking on the
    # first pair of equal samples mistakes that lull for "finished", concludes
    # there is one window, and opens a blank one with --new-window. That was the
    # empty Firefox that kept turning up. Require several consecutive stable
    # samples instead.
    local last=-1 cur stable=0 a
    local need_stable=8    # x0.5s = 4s of no new windows
    for _ in $(seq 1 60); do
      # Record any window we have not seen before, preserving arrival order.
      while read -r a; do
        [[ -n $a ]] || continue
        local seen=0 known
        for known in ${FF_ORDER[@]+"${FF_ORDER[@]}"}; do
          [[ $known == "$a" ]] && { seen=1; break; }
        done
        (( seen )) || FF_ORDER+=("$a")
      done < <(addrs_matching "$FIREFOX_MATCH")

      cur=${#FF_ORDER[@]}
      if [[ $cur == "$last" ]]; then
        stable=$((stable + 1))
        (( stable >= need_stable )) && break
      else
        stable=0
      fi
      last=$cur
      sleep 0.5
    done
    log "session restore order: ${#FF_ORDER[@]} window(s)"
    n=$(addrs_matching "$FIREFOX_MATCH" | wc -l)
    log "session restore produced $n window(s)"
  fi

  while (( n < 2 )); do
    log "only $n firefox window(s) -- opening another"
    before=$(addrs_matching "$FIREFOX_MATCH" | wc -l)
    setsid $FIREFOX_LAUNCH_EXTRA >/dev/null 2>&1 9>&- &
    for _ in $(seq 1 80); do
      sleep 0.25
      (( $(addrs_matching "$FIREFOX_MATCH" | wc -l) > before )) && break
    done
    local now
    now=$(addrs_matching "$FIREFOX_MATCH" | wc -l)
    if (( now == n )); then
      log "TIMED OUT opening an extra firefox window"
      return 1
    fi
    n=$now
  done

  # Prefer whatever is already on each screen, so repeat runs never shuffle
  # windows between monitors. Only unplaced windows get assigned.
  local on1 on2 rest
  on1=$(addr_on_ws "$FIREFOX_MATCH" "$MAIN_WS")
  on2=$(addr_on_ws "$FIREFOX_MATCH" "$WS")

  # Candidates in restore order where known, so a cold start is reproducible.
  # FF_MAIN_INDEX / FF_PORTRAIT_INDEX pick which restored window lands where;
  # flip them if the two screens come up swapped.
  local -a cands=()
  if (( ${#FF_ORDER[@]} > 0 )); then
    cands=(${FF_ORDER[@]+"${FF_ORDER[@]}"})
  else
    while read -r a; do [[ -n $a ]] && cands+=("$a"); done < <(addrs_matching "$FIREFOX_MATCH")
  fi

  # On a cold start the knob is authoritative. Firefox drops its restored
  # windows on whatever workspace happens to be focused, so "already on ws1"
  # says nothing about which window it is -- honouring it would make the
  # assignment depend on hyprctl listing order rather than restore order.
  if (( cold )) && (( ${#cands[@]} >= 2 )); then
    on1=${cands[$((FF_MAIN_INDEX - 1))]:-${cands[0]}}
    on2=${cands[$((FF_PORTRAIT_INDEX - 1))]:-${cands[1]}}
    log "cold start: restored window $FF_MAIN_INDEX -> ws$MAIN_WS, $FF_PORTRAIT_INDEX -> ws$WS"
  elif [[ -z $on1 && -z $on2 && ${#cands[@]} -ge 2 ]]; then
    on1=${cands[$((FF_MAIN_INDEX - 1))]:-${cands[0]}}
    on2=${cands[$((FF_PORTRAIT_INDEX - 1))]:-${cands[1]}}
    log "cold start: window $FF_MAIN_INDEX -> ws$MAIN_WS, window $FF_PORTRAIT_INDEX -> ws$WS"
  fi

  rest=$(printf '%s\n' ${cands[@]+"${cands[@]}"} | command grep -vx -e "${on1:-__}" -e "${on2:-__}")
  [[ -z $on1 ]] && { on1=$(echo "$rest" | sed -n 1p); rest=$(echo "$rest" | sed 1d); }
  [[ -z $on2 ]] && on2=$(echo "$rest" | sed -n 1p)

  if [[ -z $on1 || -z $on2 || $on1 == "$on2" ]]; then
    log "could not settle on two distinct firefox windows"
    return 1
  fi
  echo "$on1 $on2"
}

anim 0 false

# --- ultrawide: terminal on the left, Firefox on the right ---------------
# Only presence is ensured here, not order -- this workspace usually already
# has real work in it, and rebuilding its tree would shuffle windows that are
# perfectly fine where they are. On an empty workspace, launching the terminal
# first and Firefox second lands them left and right anyway, since force_split
# puts each new window in the right/bottom slot.
dispatch "hl.dsp.focus({ monitor = \"$MAIN_MONITOR\" })"
dispatch "hl.dsp.focus({ workspace = \"$MAIN_WS\" })"

read -r FF_MAIN FIREFOX <<<"$(ensure_two_firefox)" || exit 1
[[ -n ${FF_MAIN:-} && -n ${FIREFOX:-} ]] || { log "ABORT: no firefox pair"; exit 1; }

TERM_W=$(ensure "$TERM_MATCH" "$TERM_LAUNCH" "$MAIN_WS" new) || exit 1
for a in "$TERM_W" "$FF_MAIN"; do
  [[ $(ws_of "$a") == "$MAIN_WS" ]] || {
    dispatch "hl.dsp.window.move({ window = \"address:$a\", workspace = \"$MAIN_WS\", follow = false })"
    wait_ws "$a" "$MAIN_WS"
  }
done

# Terminal on the left, Firefox on the right. Which side each lands on depends
# on insertion order, so check and swap rather than hope.
read -r tx _ _ _ <<<"$(geom "$TERM_W")"
read -r fx _ _ _ <<<"$(geom "$FF_MAIN")"
if [[ -n ${tx:-} && -n ${fx:-} ]] && (( tx > fx )); then
  log "terminal is right of firefox -- swapping"
  dispatch "hl.dsp.focus({ window = \"address:$TERM_W\" })"
  dispatch 'hl.dsp.window.swap({ direction = "l" })'
  sleep 0.2
fi

# --- portrait: gather ----------------------------------------------------
dispatch "hl.dsp.focus({ monitor = \"$MONITOR\" })"
dispatch "hl.dsp.focus({ workspace = \"$WS\" })"

BTOP=$(ensure    "$BTOP_MATCH"    "$BTOP_LAUNCH"    "$WS" move) || exit 1
SPOTIFY=$(ensure "$SPOTIFY_MATCH" "$SPOTIFY_LAUNCH" "$WS" move) || exit 1
# FIREFOX was chosen by ensure_two_firefox alongside FF_MAIN.

# --- portrait: clear anything else out of the way ------------------------
# The dashboard is an exact three-pane layout, so any other *tiled* window on
# this workspace would take space in the tree and throw the proportions out.
# They are moved to the ultrawide rather than parked, so nothing disappears.
# Floating windows are left alone: they sit above the tiling and cost nothing.
for a in $(hyprctl clients -j | jq -r --argjson ws "$WS" \
             '.[] | select(.workspace.id == $ws and .floating == false) | .address'); do
  case $a in "$BTOP"|"$FIREFOX"|"$SPOTIFY") continue ;; esac
  cls=$(hyprctl clients -j | jq -r --arg a "$a" '.[] | select(.address==$a) | .class // .title')
  log "moving unrelated window off ws$WS -> ws$MAIN_WS: ${cls:-unknown}"
  dispatch "hl.dsp.window.move({ window = \"address:$a\", workspace = \"$MAIN_WS\", follow = false })"
  wait_ws "$a" "$MAIN_WS"
done

# --- portrait: rebuild the tree in insertion order -----------------------
log "parking windows"
for a in "$BTOP" "$FIREFOX" "$SPOTIFY"; do
  dispatch "hl.dsp.window.move({ window = \"address:$a\", workspace = \"$PARK\", follow = false })" || exit 1
done
for a in "$BTOP" "$FIREFOX" "$SPOTIFY"; do
  wait_ws_name "$a" "$PARK" || log "warning: window did not reach $PARK"
done

dispatch "hl.dsp.focus({ monitor = \"$MONITOR\" })"
dispatch "hl.dsp.focus({ workspace = \"$WS\" })"

insert() {
  local name=$1 a=$2
  log "inserting $name"
  dispatch "hl.dsp.window.move({ window = \"address:$a\", workspace = \"$WS\", follow = false })" || return 1
  wait_ws "$a" "$WS" || { log "$name never arrived on ws$WS"; return 1; }
  dispatch "hl.dsp.focus({ window = \"address:$a\" })" || return 1
}

insert btop    "$BTOP"    || exit 1
insert firefox "$FIREFOX" || exit 1
insert spotify "$SPOTIFY" || exit 1

# --- verify everything actually stacked ---------------------------------
# Dwindle picks its split axis from the node's aspect ratio, and on this
# monitor the second split is a close call, so check rather than assume.
read -r _ _ BW _ <<<"$(geom "$BTOP")"
for pair in "firefox:$FIREFOX" "spotify:$SPOTIFY"; do
  name=${pair%%:*}; a=${pair#*:}
  read -r _ _ w _ <<<"$(geom "$a")"
  if [[ -n ${w:-} && -n ${BW:-} ]] && (( w < BW * 9 / 10 )); then
    log "$name is narrower than btop -- split went side by side, correcting"
    dispatch "hl.dsp.focus({ window = \"address:$a\" })"
    dispatch 'hl.dsp.layout("togglesplit")'
    wait_settled "$a"
  fi
done

# --- refuse to size a layout that did not assemble ------------------------
for pair in "btop:$BTOP" "firefox:$FIREFOX" "spotify:$SPOTIFY"; do
  name=${pair%%:*}; a=${pair#*:}
  on=$(ws_of "$a")
  if [[ $on != "$WS" ]]; then
    log "ABORT: $name ended on workspace ${on:-none}, not $WS"
    exit 1
  fi
done

read -r _ by bw bh <<<"$(geom "$BTOP")"
read -r _ fy fw fh <<<"$(geom "$FIREFOX")"
read -r _ sy sw sh <<<"$(geom "$SPOTIFY")"

USABLE=$(( (sy + sh) - by ))
TARGET_FF=$(awk -v u="$USABLE" -v f="$F_FIREFOX" 'BEGIN{printf "%d", u*f}')

# Match the ultrawide Firefox's height as well as its top, so the two browser
# windows line up on both edges and the portrait one is a vertical mirror.
# Spotify absorbs whatever is left.
read -r _ _ _ mh <<<"$(geom "$FF_MAIN")"
if [[ -n ${mh:-} ]] && (( mh > 200 && mh < USABLE - 300 )); then
  log "matching ultrawide firefox height: ${mh}px"
  TARGET_FF=$mh
fi

# btop's height is derived, not fixed: it is whatever makes the portrait
# Firefox start at the same screen y as the one on the ultrawide, so the two
# browser windows line up across the monitors.
#
# Deriving it beats a hardcoded fraction because the target moves -- the bar's
# reserved area, gaps_in/gaps_out and border_size all shift where a window's
# top edge lands, and any of those can change from the Omarchy menu.
TARGET_BTOP=$(awk -v u="$USABLE" -v f="$F_BTOP" 'BEGIN{printf "%d", u*f}')
read -r _ my _ _ <<<"$(geom "$FF_MAIN")"
if [[ -n ${my:-} ]]; then
  # Gap between two stacked windows, measured rather than assumed
  # (2 * gaps_in + 2 * border_size).
  GAP=$(( fy - (by + bh) ))
  ALIGNED=$(( my - by - GAP ))
  if (( ALIGNED > 100 && ALIGNED < USABLE - 200 )); then
    log "aligning: ultrawide firefox top y=$my, gap ${GAP}px -> btop ${ALIGNED}px"
    TARGET_BTOP=$ALIGNED
  else
    log "computed btop height ${ALIGNED}px is out of range -- falling back to F_BTOP"
  fi
fi

log "usable ${USABLE}px -> btop ${TARGET_BTOP}, firefox ${TARGET_FF}, spotify remainder"

dispatch "hl.dsp.window.resize({ window = \"address:$BTOP\", x = $bw, y = $TARGET_BTOP })"
wait_settled "$BTOP"
dispatch "hl.dsp.window.resize({ window = \"address:$FIREFOX\", x = $fw, y = $TARGET_FF })"
wait_settled "$FIREFOX"

dispatch "hl.dsp.focus({ window = \"address:$FIREFOX\" })"

log "final layout:"
hyprctl clients -j | jq -r \
  '[.[] | select(.workspace.id == 1 or .workspace.id == 2)]
   | sort_by(.workspace.id, .at[1])[]
   | "    ws\(.workspace.id)  y=\(.at[1])\th=\(.size[1])\tw=\(.size[0])\t\(.class)"' >&2
