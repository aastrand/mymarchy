#!/bin/bash
# Build the portrait-monitor dashboard: btop on top, Firefox in the middle,
# Spotify at the bottom, tiled (not floating) on workspace 2 / DP-2.
#
# Replaces the Ubuntu-era restore_desktop.sh, which placed windows at absolute
# pixel coordinates via wmctrl and the GNOME Window Calls extension. GNOME is a
# floating WM so that was the only option there; here the windows stay properly
# tiled, so a fourth window still tiles sensibly, closing one reflows the rest,
# and the usual focus/swap bindings keep working.
#
# The tree is rebuilt from scratch each run rather than nudged into shape,
# because dwindle's layout depends entirely on insertion order. Windows are
# parked on a special workspace, then reinserted one at a time with focus set
# so each split lands where it should:
#
#     root
#     |-- btop      20%
#     `-- node
#         |-- firefox  57%
#         `-- spotify  23%
#
# NOTE ON SYNTAX: Omarchy configures Hyprland in Lua, which replaces the legacy
# `hyprctl dispatch <name> <args>` form. Passing legacy syntax fails with
# "')' expected near ..." and exit 7. Dispatchers must be written as Lua, e.g.
#   hyprctl dispatch 'hl.dsp.window.move({ window = "address:0x1", workspace = "2" })'
# Introspect the API with (hyprctl eval cannot return values, so write a file):
#   hyprctl eval "local f=io.open('/tmp/o','w')
#                 for k,v in pairs(hl.dsp.window) do f:write(k..'\n') end f:close()"

set -uo pipefail

WS=2
MONITOR=DP-2
PARK="special:dashboard-build"

# Fractions of usable height, top to bottom. Spotify takes the remainder.
# Measured from the layout after adjusting the splits by hand, rather than
# guessed: 489 / 1385 / 608 px of a 2510px usable height.
F_BTOP=0.195
F_FIREFOX=0.552

# btop runs in a plain terminal under its own class rather than through
# omarchy-launch-or-focus-tui. That helper uses the app-id org.omarchy.btop,
# which Omarchy tags "+floating-window" (float, centred, 875x600) because it is
# meant to be the transient SUPER+CTRL+T overlay. A floating window cannot join
# a tiled stack, so it needs a class outside that rule.
#
# window_padding_width is overridden to 0 and the font shrunk for this window
# only: the pane is 20% of the screen, and kitty's usual 14px padding costs
# 28px vertically -- about one text row -- which is exactly enough to put btop
# under its 24-row minimum ("Terminal size too small").
BTOP_MATCH='^dashboard-btop$'
BTOP_LAUNCH='uwsm app -- kitty --class dashboard-btop -o window_padding_width=0 -o font_size=10 -e btop'
FIREFOX_MATCH='^firefox$'
FIREFOX_LAUNCH='uwsm app -- firefox'
SPOTIFY_MATCH='^Spotify$'
SPOTIFY_LAUNCH='uwsm app -- spotify'

log() { printf '  %s\n' "$*" >&2; }

# Animations make every move play a transition, which is both the visible
# churn during a rebuild and a real part of the wall-clock cost. Suppress them
# for the duration and restore on any exit, including failure.
anim() { hyprctl keyword animations:enabled "$1" >/dev/null 2>&1 ||
         hyprctl eval "hl.config({ animations = { enabled = $2 } })" >/dev/null 2>&1; }
restore_anim() { anim 1 true; }
trap restore_anim EXIT INT TERM

# Run a Lua dispatcher, reporting failure instead of hiding it.
dispatch() {
  local lua=$1 out
  out=$(hyprctl dispatch "$lua" 2>&1)
  if [[ $out != "ok" ]]; then
    log "DISPATCH FAILED: $lua"
    log "  -> $out"
    return 1
  fi
}

# First matching window already on the target workspace.
#
# Scoped to the workspace on purpose: these apps legitimately have more than one
# window -- there is a Firefox on the ultrawide too -- and a global "first
# match" would drag the wrong one onto the portrait screen.
addr_on_ws() {
  hyprctl clients -j | jq -r --arg re "$1" --argjson ws "$WS" \
    'map(select((.class | test($re)) and .workspace.id == $ws))
     | if length > 0 then .[0].address else "" end'
}

addrs_matching() {
  hyprctl clients -j | jq -r --arg re "$1" '.[] | select(.class | test($re)) | .address'
}

# Ensure a window for $1 exists, launching $2 only if the app is not running at
# all -- matching restore_desktop.sh, whose launch() only ran a process when
# pgrep found nothing and whose move() did the rest.
ensure() {
  local re=$1 cmd=$2 a before after
  a=$(addr_on_ws "$re")
  if [[ -n $a ]]; then
    log "reusing window on ws$WS: $re"
    echo "$a"; return 0
  fi

  a=$(addrs_matching "$re" | head -1)
  if [[ -n $a ]]; then
    log "moving existing window onto ws$WS: $re"
    echo "$a"; return 0
  fi

  before=$(addrs_matching "$re" | sort)
  log "launching: $cmd"
  setsid $cmd >/dev/null 2>&1 &

  for _ in $(seq 1 80); do
    sleep 0.25
    after=$(addrs_matching "$re" | sort)
    a=$(comm -13 <(echo "$before") <(echo "$after") | head -1)
    [[ -n $a ]] && { echo "$a"; return 0; }
  done
  log "TIMED OUT waiting for a new $re window"
  return 1
}

geom() {
  hyprctl clients -j | jq -r --arg a "$1" \
    '.[] | select(.address == $a) | "\(.at[0]) \(.at[1]) \(.size[0]) \(.size[1])"'
}

ws_of() {
  hyprctl clients -j | jq -r --arg a "$1" '.[] | select(.address == $a) | .workspace.id'
}

# Poll until window $1 reports being on workspace $2, up to ~2s. Waiting for
# the state we actually want beats sleeping a fixed guess: it is correct when
# Hyprland is slow and instant when it is not.
wait_ws() {
  local a=$1 want=$2
  for _ in $(seq 1 40); do
    [[ $(ws_of "$a") == "$want" ]] && return 0
    sleep 0.05
  done
  return 1
}

# Same, but by workspace *name*. Special workspaces get an allocated negative
# id that is not predictable, so parking has to be waited on by name.
wait_ws_name() {
  local a=$1 want=$2 cur
  for _ in $(seq 1 40); do
    cur=$(hyprctl clients -j | jq -r --arg a "$a" '.[] | select(.address==$a) | .workspace.name')
    [[ $cur == "$want" ]] && return 0
    sleep 0.05
  done
  return 1
}

# Poll until window $1's height stops changing, so a resize has settled.
wait_settled() {
  local a=$1 last="" cur
  for _ in $(seq 1 40); do
    cur=$(hyprctl clients -j | jq -r --arg a "$a" '.[] | select(.address==$a) | .size[1]')
    [[ -n $cur && $cur == "$last" ]] && return 0
    last=$cur
    sleep 0.05
  done
}

# --- gather -------------------------------------------------------------
log "gathering windows"
BTOP=$(ensure "$BTOP_MATCH" "$BTOP_LAUNCH")          || exit 1
FIREFOX=$(ensure "$FIREFOX_MATCH" "$FIREFOX_LAUNCH") || exit 1
SPOTIFY=$(ensure "$SPOTIFY_MATCH" "$SPOTIFY_LAUNCH") || exit 1

# --- rebuild the tree in insertion order --------------------------------
anim 0 false

log "parking windows"
for a in "$BTOP" "$FIREFOX" "$SPOTIFY"; do
  dispatch "hl.dsp.window.move({ window = \"address:$a\", workspace = \"$PARK\", follow = false })" || exit 1
done
for a in "$BTOP" "$FIREFOX" "$SPOTIFY"; do
  wait_ws_name "$a" "$PARK" || log "warning: window did not reach $PARK"
done

dispatch "hl.dsp.focus({ monitor = \"$MONITOR\" })"
dispatch "hl.dsp.focus({ workspace = \"$WS\" })"

insert() {
  local name=$1 a=$2
  log "inserting $name"
  dispatch "hl.dsp.window.move({ window = \"address:$a\", workspace = \"$WS\", follow = false })" || return 1
  wait_ws "$a" "$WS" || { log "$name never arrived on ws$WS"; return 1; }
  dispatch "hl.dsp.focus({ window = \"address:$a\" })" || return 1
}

insert btop    "$BTOP"    || exit 1
insert firefox "$FIREFOX" || exit 1
insert spotify "$SPOTIFY" || exit 1

# --- verify everything actually stacked ---------------------------------
# Dwindle picks its split axis from the node's aspect ratio, and on this
# monitor the second split is a close call, so check rather than assume.
read -r _ _ BW _ <<<"$(geom "$BTOP")"
for pair in "firefox:$FIREFOX" "spotify:$SPOTIFY"; do
  name=${pair%%:*}; a=${pair#*:}
  read -r _ _ w _ <<<"$(geom "$a")"
  if [[ -n ${w:-} && -n ${BW:-} ]] && (( w < BW * 9 / 10 )); then
    log "$name is narrower than btop -- split went side by side, correcting"
    dispatch "hl.dsp.focus({ window = \"address:$a\" })"
    dispatch 'hl.dsp.layout("togglesplit")'
    wait_settled "$a"
  fi
done

# --- refuse to size a layout that did not come out right -----------------
for pair in "btop:$BTOP" "firefox:$FIREFOX" "spotify:$SPOTIFY"; do
  name=${pair%%:*}; a=${pair#*:}
  on=$(ws_of "$a")
  if [[ $on != "$WS" ]]; then
    log "ABORT: $name ended on workspace ${on:-none}, not $WS"
    exit 1
  fi
done

read -r _ by bw bh <<<"$(geom "$BTOP")"
read -r _ fy fw fh <<<"$(geom "$FIREFOX")"
read -r _ sy sw sh <<<"$(geom "$SPOTIFY")"

USABLE=$(( (sy + sh) - by ))
TARGET_BTOP=$(awk -v u="$USABLE" -v f="$F_BTOP"    'BEGIN{printf "%d", u*f}')
TARGET_FF=$(awk   -v u="$USABLE" -v f="$F_FIREFOX" 'BEGIN{printf "%d", u*f}')
log "usable ${USABLE}px -> btop ${TARGET_BTOP}, firefox ${TARGET_FF}, spotify remainder"

dispatch "hl.dsp.window.resize({ window = \"address:$BTOP\", x = $bw, y = $TARGET_BTOP })"
wait_settled "$BTOP"
dispatch "hl.dsp.window.resize({ window = \"address:$FIREFOX\", x = $fw, y = $TARGET_FF })"
wait_settled "$FIREFOX"

dispatch "hl.dsp.focus({ window = \"address:$FIREFOX\" })"

log "final layout:"
hyprctl clients -j | jq -r --argjson ws "$WS" \
  '.[] | select(.workspace.id == $ws) | "    y=\(.at[1])\th=\(.size[1])\tw=\(.size[0])\t\(.class)"' \
  | sort -n >&2
